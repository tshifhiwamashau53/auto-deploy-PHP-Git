{
  "name": "tshifhiwamashau53/auto-deploy-PHP-Git",
  "description": "Automatic deploy system for PHP apps",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "symfony/console": "^6.0",
    "monolog/monolog": "^2.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "AutoDeploy\\": "src/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php bin/deploy --setup-logs"
    ]
  }
}
